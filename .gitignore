# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# env files (keep examples)
.env
.env.*
!.env.example
!**/.env.example

# logs / debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# testing / coverage
coverage/
*.lcov
.nyc_output/

# Next.js (frontend)
frontend/.next/
frontend/out/
**/.next/
**/out/

# backend / TypeScript build
dist/
build/
backend/dist/
*.tsbuildinfo

# Next.js generated types (regenerated by next dev/build)
frontend/next-env.d.ts
**/next-env.d.ts

# Prisma
backend/prisma/*.db
backend/prisma/*.db-journal

# caches
.cache/
.turbo/
.eslintcache
.stylelintcache
*.swp
*.swo

# editors / IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.code-workspace

# OS
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# secrets / certs
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# Vercel / deployment
.vercel/

# Docker overrides (local-only)
docker-compose.override.yml

# misc
*.local
tmp/
temp/
.temp/
